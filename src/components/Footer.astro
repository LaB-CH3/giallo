---
import LinkedIn from '../assets/linkedin.svg'
import Twitter from '../assets/twitter.svg'
const link = `https://github.com/LaB-CH3/giallo`

---

<footer>
    <div class="container row">
        <div class="footer-link flex js one-half column">
            <a href={link}>About</a> <a href={link}>Help Center</a>
            <a href={link}>Privacy</a>
            <a href={link}>Terms</a> 
        </div>
        <div class="footer-note one-half column">
            <div class="u-pull-right">
                <div class="flex">
                    <p>© Giallo</p>
                    <a href={link}><img src={Twitter} alt="Twitter icon"></a>
                    <a href={link}><img src={LinkedIn} alt="Linkedin icon"></a>
                </div>
            </div>
        </div>
    </div>
</footer>

<style lang="scss">
 

  footer{
    padding: 40px 0;
    background-color: #fff;

    a, p{
      color: #222;
      font-size: 1.8rem;
    }
    .footer-link a{
      padding-right: 20px;
      text-decoration: none;
    }
    .container{
      padding: 30px;
      border-radius: 50px;
      
      .footer-note{
        a{
          padding-left: 20px;
          img{
            width: 28px;
          }
        }
      }
    }
    @media (max-width:700px) {
      .footer-link a{
        font-size: 1.6rem;
      }
        .flex{
            justify-content: center;
        }
        .column{
            padding: 10px 0;
        }
        .u-pull-right{
            float: none;
        }
    }
  }

  .flex{
    display: flex;;
  }
</style>